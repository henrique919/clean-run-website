---
// Hero copy block: eyebrow, headline (with optional highlighted tail), sub, support, CTAs.
import Icon from './Icon.astro';
export interface Props {
  eyebrow: string;
  heading: string;
  highlight?: string;
  sub: string;
  support?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  eyebrow,
  heading,
  highlight,
  sub,
  support,
  primaryHref = '/demo/',
  primaryLabel = 'Book a 20-minute walkthrough',
  secondaryHref = '/features/defect-management/',
  secondaryLabel = 'See sample defect register',
} = Astro.props;
---
<div>
  <div class="inline-flex items-center gap-2 bg-brand/[0.1] border border-brand/[0.25] rounded-full px-3.5 py-1.5 mb-7">
    <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
    <span class="text-[11px] font-bold text-brand tracking-wider uppercase font-heading">{eyebrow}</span>
  </div>
  <h1 class="font-heading font-extrabold leading-[1.05] tracking-[-1.5px] text-white mb-5 text-[clamp(34px,3.9vw,56px)]">
    {heading}{highlight && <> <span class="text-brand">{highlight}</span></>}
  </h1>
  <p class="text-[18px] leading-relaxed text-[#C2C9D2] mb-4 max-w-[520px]">{sub}</p>
  {support && <p class="text-[14px] leading-relaxed text-[#8A93A0] mb-8 max-w-[480px]">{support}</p>}
  <div class="flex items-center gap-3 flex-wrap">
    <a href={primaryHref} class="inline-flex items-center gap-2 bg-brand text-navy px-6 py-3.5 rounded-lg text-[15px] font-bold font-heading hover:bg-white transition-colors">{primaryLabel} <Icon name="arrow" size={15} width={2} /></a>
    <a href={secondaryHref} class="inline-flex items-center gap-2 bg-white/[0.06] text-[#E5E7EB] px-5.5 py-3.5 rounded-lg text-[15px] font-medium border border-white/[0.12] hover:border-brand/40 transition-colors">{secondaryLabel}</a>
  </div>
</div>
