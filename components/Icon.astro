---
// Clean, geometric inline SVG icons (Lucide-style). Use instead of emoji.
// Usage: <Icon name="camera" size={20} class="text-brand" />
export interface Props {
  name: string;
  size?: number;
  class?: string;
  width?: number; // stroke width
}
const { name, size = 20, class: cls = '', width = 1.8 } = Astro.props;

const icons: Record<string, string> = {
