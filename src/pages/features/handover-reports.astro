---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import ReportPreviewCard from '../../components/ReportPreviewCard.astro';

const steps = [
  { n: '1', t: 'Pick the project', b: 'Choose the project or block you are handing over. Every item already lives in the register.' },
  { n: '2', t: 'Choose what to include', b: 'All items, or filter to a level, trade or status. Open items show as open — nothing is hidden.' },
  { n: '3', t: 'Generate', b: 'CleanRun IQ builds the report with each item, its status and the photo behind it.' },
  { n: '4', t: 'Hand it over', b: 'A clean record for the handover meeting — and one you can pull up again at DLP.' },
];
const includes = [
  'Every item with its location, trade and status',
  'The original and rectification photo on each closed item',
  'The history — who raised, who fixed, who closed, and when',
  'Open and deferred items, stated plainly rather than left out',
];
---
<BaseLayout title="Handover Reporting Software | CleanRun IQ" description="Export clean PC/DLP-ready handover reports from your live defect register, including statuses, photos and closeout history.">
  <section class="bg-navy pt-[116px] pb-16 px-8 relative overflow-hidden border-b border-white/[0.05]">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse at top right,rgba(32,197,94,0.05) 0%,transparent 60%)"></div>
    <div class="max-w-[1100px] mx-auto relative z-10 grid lg:grid-cols-[1fr_0.8fr] gap-12 items-center">
      <div>
        <div class="mb-6"><Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Features', href: '/features/' }, { label: 'Handover Reports' }]} /></div>
        <div class="inline-flex items-center gap-2 bg-brand/[0.1] border border-brand/[0.25] rounded-full px-3 py-1 mb-5">
          <Icon name="report" size={12} class="text-brand" />
          <span class="text-[10px] font-bold text-brand tracking-wider uppercase font-heading">Handover reports</span>
        </div>
        <h1 class="font-heading font-extrabold text-[clamp(32px,3.6vw,52px)] tracking-[-1.4px] text-white mb-4 leading-[1.05]">The handover pack, straight from the register.</h1>
        <p class="text-[17px] text-[#B6BEC8] leading-relaxed max-w-[500px] mb-8">No rebuilding the list from messages and photo folders the night before practical completion. Generate the report from the live register, with the picture on every item.</p>
        <a href="/demo/" class="inline-flex items-center gap-2 bg-brand text-navy px-6 py-3.5 rounded-lg text-[15px] font-bold font-heading hover:bg-white transition-colors">Book a 20-minute walkthrough <Icon name="arrow" size={15} width={2} /></a>
      </div>
      <div class="flex justify-center lg:justify-end"><ReportPreviewCard class="scale-[1.35] origin-center" /></div>
    </div>
  </section>

  <section class="bg-[#F3F4F6] px-8 py-16">
    <div class="max-w-[1000px] mx-auto">
      <h2 class="font-heading font-extrabold text-[26px] md:text-[30px] tracking-[-0.8px] text-[#1B2025] mb-9 max-w-[520px]">Four steps, not a weekend.</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {steps.map((s) => (
          <div class="bg-white rounded-xl border border-[#E2E5E9] p-5">
            <div class="w-8 h-8 rounded-lg bg-navy text-brand font-heading font-extrabold text-[13px] flex items-center justify-center mb-3.5">{s.n}</div>
            <h3 class="font-heading text-[14px] font-bold text-[#1B2025] mb-1.5">{s.t}</h3>
            <p class="text-[12.5px] leading-relaxed text-[#6B7280]">{s.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white px-8 py-16 border-t border-[#E2E5E9]">
    <div class="max-w-[820px] mx-auto">
      <h2 class="font-heading font-extrabold text-[26px] md:text-[30px] tracking-[-0.8px] text-[#1B2025] mb-7">What is in the report.</h2>
      <div class="flex flex-col gap-3">
        {includes.map((t) => (
          <div class="flex items-start gap-3"><div class="w-6 h-6 rounded-md bg-brand/[0.1] flex items-center justify-center shrink-0 mt-0.5"><Icon name="check" size={13} class="text-[#0C7733]" width={2.4} /></div><span class="text-[15px] text-[#374151] leading-snug">{t}</span></div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-2.5">
        <a href="/features/photo-evidence/" class="inline-flex items-center gap-1.5 bg-white border border-[#E2E5E9] text-[#374151] px-3.5 py-2 rounded-lg text-[12.5px] font-medium hover:border-brand/40 transition-colors"><Icon name="arrow" size={11} class="text-brand" width={2} />Photo evidence</a>
        <a href="/solutions/project-managers/" class="inline-flex items-center gap-1.5 bg-white border border-[#E2E5E9] text-[#374151] px-3.5 py-2 rounded-lg text-[12.5px] font-medium hover:border-brand/40 transition-colors"><Icon name="arrow" size={11} class="text-brand" width={2} />For project managers</a>
      </div>
    </div>
  </section>

  <CTASection heading="See a handover pack generated live." body="Book a short walkthrough and watch the report come straight out of the register, with the photo on every item." />
</BaseLayout>
