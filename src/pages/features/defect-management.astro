---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';

const pains = [
  { icon: '\u{1F4CA}', title: 'Spreadsheets with no accountability', body: 'Rows of defects with no photos, no assignments and no way to prove what was actually fixed.' },
  { icon: '\u{1F4AC}', title: 'Trades that go quiet', body: 'Defect assignment via text message with no follow-up system. Trades say it\u2019s done. You have no proof.' },
  { icon: '\u{1F525}', title: 'Last-minute handover panic', body: 'Compiling evidence the night before PC. Chasing trades for photos they never took. Reports that aren\u2019t defensible.' },
];

const capabilities = [
  { title: 'Photo-first capture, always', body: 'A defect cannot be logged without a photo. Required at capture, rectification and closeout \u2014 enforced by the system.' },
  { title: 'Trade assignment with due dates', body: 'Every defect is issued to a named trade and subcontractor. Due dates are tracked. Overdue items are visible to everyone.' },
  { title: 'Evidence review and approval', body: 'The site manager reviews rectification evidence, approves or rejects, and controls closeout. No self-certification allowed.' },
  { title: 'Full audit trail, locked per item', body: 'Every action \u2014 creation, assignment, rectification, approval, closeout \u2014 is logged with name, date and time.' },
];

const steps = [
  { num: '01', label: 'Capture', body: 'Photo + type + location + trade. All required. No shortcuts.' },
  { num: '02', label: 'Assign', body: 'Issued to trade + sub + due date. Clear accountability.' },
  { num: '03', label: 'Rectify', body: 'The trade fixes it and uploads photo evidence from site.' },
  { num: '04', label: 'Review', body: 'Site manager approves or rejects evidence. Full control.' },
  { num: '05', label: 'Close + Report', body: 'Evidence chain locked. Handover report generated instantly.' },
];

const roles = [
  { emoji: '\u{1F477}', title: 'Site Managers', body: 'Capture on mobile. Assign instantly. Review evidence without chasing. Close with proof.', href: '/solutions/site-managers/' },
  { emoji: '\u{1F4CB}', title: 'Project Managers', body: 'Full visibility across all projects. Track closeout velocity. Know what\u2019s open before the client asks.', href: '/solutions/project-managers/' },
  { emoji: '\u{1F50D}', title: 'Quality Managers', body: 'Enforce evidence standards. Control what passes inspection. Export compliance-ready reports.', href: '/solutions/quality-managers/' },
  { emoji: '\u{1F527}', title: 'Subcontractors', body: 'See exactly what\u2019s assigned. Upload evidence from any phone. No app download, no training.', href: '/solutions/subcontractors/' },
];

const faqs = [
  { q: 'What types of defect items can I track in CleanRun IQ?', a: 'CleanRun IQ tracks three item types: Defects (work completed below standard), Incomplete Works (work not yet started or finished) and Client Defects (items raised by the client post-handover). Each follows the same photo evidence workflow.' },
  { q: 'How does the three-photo evidence chain work?', a: 'Every item requires a capture photo when logged. Rectification requires the subcontractor to upload at least one photo before the item moves to Review. Closeout requires site manager approval. The chain is enforced by the system and cannot be bypassed.' },
  { q: 'Can subcontractors use CleanRun IQ without downloading an app?', a: 'Yes. Subcontractors access their assigned items through a browser link \u2014 no download, no account setup. They see only the items assigned to them and upload rectification photos from any phone or tablet.' },
  { q: 'How do I generate a handover report?', a: 'From the project defect register, select the items to include and click Generate Report. CleanRun IQ produces a structured PDF with all defect details, evidence photos and closeout status in seconds.' },
  { q: 'Is CleanRun IQ suitable for small residential builders?', a: 'Yes. CleanRun IQ scales from small residential builds to large commercial and apartment projects. The workflow is consistent regardless of project size, making it easy to manage your whole portfolio the same way.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const trustBar = ['Photo required at every stage','Trade assignment with due dates','Full audit trail per item','Handover-ready reports in seconds','No app download for subcontractors'];
const relatedLinks = [
  { href: '/features/photo-evidence/', label: 'Photo Evidence Chain' },
  { href: '/features/subcontractor-closeout/', label: 'Subcontractor Closeout' },
  { href: '/features/handover-reports/', label: 'Handover Reports' },
  { href: '/solutions/site-managers/', label: 'Solution for Site Managers' },
  { href: '/resources/construction-defect-management-guide/', label: 'Defect Management Guide' },
  { href: '/pricing/', label: 'Pricing' },
];
---
<BaseLayout
  title="Construction Defect Management Software"
  description="Capture, assign and close construction defects with photo evidence \u2014 without spreadsheet chaos. Evidence-first defect tracking built for Australian site teams."
  schema={faqSchema}
>
  {/* HERO */}
  <section class="min-h-[90vh] bg-navy pt-[66px] relative overflow-hidden flex items-center">
    <div class="absolute inset-0 grid-overlay pointer-events-none"></div>
    <div class="absolute left-0 top-[20%] w-[40%] h-[60%] pointer-events-none" style="background:radial-gradient(ellipse at left,rgba(32,197,94,0.06) 0%,transparent 65%)"></div>
    <div class="max-w-[1200px] w-full mx-auto px-8 py-20 grid lg:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <div class="mb-5.5"><Breadcrumb items={[{ label: 'Features', href: '/features/' }, { label: 'Defect Management' }]} /></div>
        <div class="inline-flex items-center gap-2 bg-brand/[0.08] border border-brand/[0.22] rounded-full px-3.5 py-1.5 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-blink"></span>
          <span class="text-[11px] font-bold text-brand tracking-wider uppercase font-heading">Core Feature</span>
        </div>
        <h1 class="font-heading font-extrabold leading-[1.06] tracking-[-1.5px] text-white mb-5 text-[clamp(36px,3.8vw,58px)]">Construction Defect Management Software</h1>
        <p class="text-lg leading-relaxed text-[#9CA3AF] mb-3 max-w-[480px]">Capture, assign and close every defect with photo evidence \u2014 without the spreadsheet chaos.</p>
        <p class="text-sm leading-relaxed text-[#4B5563] mb-8 max-w-[440px]">Evidence-first defect tracking built for Australian construction teams. Every item. Every photo. Every trade. One clean handover report.</p>
        <div class="flex items-center gap-3 flex-wrap mb-4.5">
          <a href="/demo/" class="inline-flex items-center gap-2 bg-brand text-navy px-6 py-3 rounded-lg text-[15px] font-bold font-heading">Book a Demo <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a href="https://app.cleanruniq.com/" class="inline-flex items-center gap-2 bg-white/[0.05] text-[#E5E7EB] px-5.5 py-3 rounded-lg text-[15px] font-medium border border-white/10">View Live Demo</a>
        </div>
        <a href="/resources/defect-closeout-checklist/" class="inline-flex items-center gap-1.5 text-[13px] text-[#4B5563] hover:text-[#9CA3AF] transition-colors"><svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2 4.5h9M2 7.5h9M2 10.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>Download Free Defect Closeout Checklist</a>
      </div>

      {/* Register mockup */}
      <div class="relative">
        <div class="bg-white rounded-[10px] overflow-hidden shadow-[0_28px_80px_rgba(0,0,0,0.5)]">
          <div class="bg-[#F3F4F6] px-3 py-1.5 flex items-center gap-1.5 border-b border-[#DDE1E5]">
            <div class="flex gap-1"><div class="w-2 h-2 rounded-full bg-[#EF4444]"></div><div class="w-2 h-2 rounded-full bg-[#F59E0B]"></div><div class="w-2 h-2 rounded-full bg-[#22C55E]"></div></div>
            <div class="flex-1 bg-[#DDE1E5] rounded-sm h-4 flex items-center px-2"><span class="text-[9px] text-[#6B7280] font-mono">app.cleanruniq.com</span></div>
          </div>
          <div class="bg-navy px-3 py-2 flex items-center justify-between">
            <span class="font-heading text-[11px] font-bold text-[#E5E7EB]">Parkview Residences &mdash; Block B</span>
            <div class="flex gap-1"><span class="bg-[#FEE4E2] text-[#B42318] text-[8px] font-bold px-1.5 py-0.5 rounded-sm">7 OPEN</span><span class="bg-[#E1F7E9] text-[#0C7733] text-[8px] font-bold px-1.5 py-0.5 rounded-sm">18 CLOSED</span></div>
          </div>
          <div class="grid grid-cols-[64px_1fr_72px_84px] px-3 py-1.5 bg-[#F9FAFB] border-b border-[#DDE1E5]">
            <span class="text-[8px] font-bold text-[#6B7280] uppercase tracking-wide">Ref</span><span class="text-[8px] font-bold text-[#6B7280] uppercase tracking-wide">Description</span><span class="text-[8px] font-bold text-[#6B7280] uppercase tracking-wide">Trade</span><span class="text-[8px] font-bold text-[#6B7280] uppercase tracking-wide">Status</span>
          </div>
          {[
            { ref: 'DEF-019', d: 'Ceiling crack \u2013 Apt 201', tr: 'Plasterer', st: 'CLOSED', cls: 'bg-[#E1F7E9] text-[#0C7733]', row: '' },
            { ref: 'DEF-020', d: 'Incomplete grout \u2013 Apt 202', tr: 'Tiler', st: 'ISSUED', cls: 'bg-[#FFF4D6] text-[#B45309]', row: 'bg-[#FFF7DB]/40' },
            { ref: 'DEF-021', d: 'Door not closing \u2013 Unit 203', tr: 'Carpenter', st: 'OPEN', cls: 'bg-[#FEE4E2] text-[#B42318]', row: '' },
            { ref: 'DEF-022', d: 'Paint bleed \u2013 L2 corridor', tr: 'Painter', st: 'REVIEW', cls: 'bg-[#F3F4F6] text-[#374151] border border-[#DDE1E5]', row: '' },
          ].map((r) => (
            <div class={`grid grid-cols-[64px_1fr_72px_84px] px-3 py-2 border-b border-[#F3F4F6] items-center ${r.row}`}>
              <span class="text-[9px] font-extrabold text-[#1B2025] font-heading">{r.ref}</span>
              <span class="text-[10px] text-[#374151]">{r.d}</span>
              <span class="text-[9px] text-[#6B7280]">{r.tr}</span>
              <span><span class={`text-[8px] font-bold px-1.5 py-0.5 rounded-sm ${r.cls}`}>{r.st}</span></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* TRUST BAR */}
  <div class="bg-navy-card border-y border-white/[0.05] px-8 py-4">
    <div class="max-w-[1200px] mx-auto flex items-center justify-center gap-7 flex-wrap">
      {trustBar.map((t) => (
        <div class="flex items-center gap-2"><svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M1.5 6.5l2.5 2.5 7-7" stroke="#20C55E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="text-xs text-[#9CA3AF]">{t}</span></div>
      ))}
    </div>
  </div>

  {/* PAIN */}
  <section class="bg-navy-card px-8 py-20 border-b border-white/[0.05]">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-11 max-w-[500px] mx-auto">
        <div class="inline-flex items-center gap-2 bg-[#B42318]/[0.08] border border-[#B42318]/20 rounded-full px-3.5 py-1.5 mb-4"><span class="text-[11px] font-bold text-[#F87171] tracking-wider uppercase font-heading">The problem today</span></div>
        <h2 class="font-heading font-extrabold text-[38px] tracking-[-1px] text-white mb-3 leading-[1.1]">Defects don't fail handovers.<br />Defect management does.</h2>
        <p class="text-[15px] text-[#6B7280] leading-relaxed">Most builders track defects. Few can prove they were fixed \u2014 with photo evidence, a named person and a timestamp.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-3.5">
        {pains.map((p) => (
          <div class="bg-white/[0.03] border border-white/[0.06] border-t-2 border-t-[#B42318]/[0.4] rounded-[10px] p-6">
            <div class="text-xl mb-3">{p.icon}</div>
            <h3 class="font-heading text-[15px] font-bold text-[#E5E7EB] mb-1.5">{p.title}</h3>
            <p class="text-[13px] leading-relaxed text-[#4B5563]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* PRODUCT SOLUTION */}
  <section class="bg-[#F3F4F6] px-8 py-20">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 bg-brand/[0.07] border border-brand/[0.15] rounded-full px-3.5 py-1.5 mb-4"><span class="text-[11px] font-bold text-brand tracking-wider uppercase font-heading">How CleanRun IQ solves it</span></div>
        <h2 class="font-heading font-extrabold text-[38px] tracking-[-1px] text-[#1B2025]">One system. Every defect.<br />Full evidence chain.</h2>
      </div>
      <div class="grid lg:grid-cols-2 gap-14 items-start">
        <div class="flex flex-col gap-5">
          {capabilities.map((c) => (
            <div class="flex gap-4 items-start p-5 bg-white rounded-[10px] border border-[#DDE1E5]">
              <div class="w-9.5 h-9.5 bg-brand/[0.08] rounded-lg flex items-center justify-center shrink-0 border border-brand/[0.15]"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#20C55E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg></div>
              <div><h3 class="font-heading text-sm font-bold text-[#1B2025] mb-1">{c.title}</h3><p class="text-[13px] leading-snug text-[#6B7280]">{c.body}</p></div>
            </div>
          ))}
        </div>
        <div class="bg-white rounded-xl border border-[#DDE1E5] overflow-hidden">
          <div class="bg-navy px-4 py-2.5"><span class="font-heading text-[11px] font-bold text-[#9CA3AF] uppercase tracking-wide">CleanRun IQ &mdash; Three Item Types</span></div>
          <div class="p-4">
            {[
              { e: '\u{1F534}', t: 'Defect', d: 'Work completed but below the required standard. Requires rectification and photo evidence before closeout.' },
              { e: '\u{1F7E1}', t: 'Incomplete Work', d: 'Work not yet started or fully completed. Must be finished and evidenced before the item can close.' },
              { e: '\u{1F535}', t: 'Client Defect', d: 'Defect items raised by the client post-handover. Managed through the same evidence-first workflow during DLP.' },
            ].map((it, i) => (
              <div class={`flex gap-2.5 items-start ${i < 2 ? 'mb-3 pb-3 border-b border-[#F3F4F6]' : ''}`}>
                <div class="w-8.5 h-8.5 rounded-lg flex items-center justify-center shrink-0 text-sm bg-[#F3F4F6]">{it.e}</div>
                <div><div class="font-heading text-[13px] font-bold text-[#1B2025] mb-0.5">{it.t}</div><div class="text-[11px] leading-snug text-[#6B7280]">{it.d}</div></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* WORKFLOW */}
  <section class="bg-navy px-8 py-20 border-t border-white/[0.05]">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 bg-brand/[0.07] border border-brand/[0.18] rounded-full px-3.5 py-1.5 mb-4"><span class="text-[11px] font-bold text-brand tracking-wider uppercase font-heading">The CleanRun IQ process</span></div>
        <h2 class="font-heading font-extrabold text-[38px] tracking-[-1px] text-white mb-3">Five steps to a clean handover.</h2>
        <p class="text-[15px] text-[#6B7280] max-w-[440px] mx-auto">Consistent. Repeatable. Defensible. The same process on every project.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-2">
        {steps.map((s, i) => (
          <div class={`rounded-[10px] px-4 py-5 text-center ${i === 4 ? 'bg-brand/[0.05] border border-brand/[0.25]' : 'bg-white/[0.03] border border-white/[0.07]'}`}>
            <div class="font-heading text-[11px] font-bold text-brand mb-2.5">{s.num}</div>
            <div class={`font-heading text-[13px] font-bold mb-1.5 ${i === 4 ? 'text-brand' : 'text-white'}`}>{s.label}</div>
            <p class="text-[11px] leading-snug text-[#4B5563]">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ROLES */}
  <section class="bg-navy-card px-8 py-20 border-t border-white/[0.05]">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-11">
        <h2 class="font-heading font-extrabold text-[36px] tracking-[-0.8px] text-white mb-2.5">Built for every role on site.</h2>
        <p class="text-[15px] text-[#6B7280] max-w-[420px] mx-auto">One platform. Different views. Every role gets exactly what they need.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-3.5">
        {roles.map((r) => (
          <div class="bg-white/[0.03] border border-white/[0.07] rounded-[10px] p-5.5 flex gap-4 items-start">
            <div class="w-10 h-10 bg-navy rounded-lg flex items-center justify-center shrink-0 text-lg">{r.emoji}</div>
            <div>
              <h3 class="font-heading text-sm font-bold text-white mb-1.5">{r.title}</h3>
              <p class="text-xs leading-snug text-[#4B5563] mb-2">{r.body}</p>
              <a href={r.href} class="inline-flex items-center gap-1 text-[11px] font-bold text-brand font-heading">See workflow <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 5h8M5 2l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="bg-navy px-8 py-20 border-t border-white/[0.05]">
    <div class="max-w-[760px] mx-auto">
      <h2 class="font-heading font-extrabold text-[36px] tracking-[-0.8px] text-white mb-11 text-center">Common questions about defect management.</h2>
      <div class="flex flex-col gap-1">
        {faqs.map((f) => (
          <div class="faq-item bg-white/[0.03] border border-white/[0.07] rounded-[10px] overflow-hidden">
            <button class="faq-head w-full flex items-start justify-between gap-3 px-5.5 py-4.5 text-left">
              <span class="font-heading text-sm font-bold text-[#CBD5E1] leading-snug">{f.q}</span>
              <svg class="faq-arrow shrink-0 mt-0.5 text-[#4B5563] transition-transform" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="faq-body grid grid-rows-[0fr] transition-all duration-300"><div class="overflow-hidden"><p class="text-sm leading-relaxed text-[#6B7280] px-5.5 pb-4.5">{f.a}</p></div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* INTERNAL LINKS */}
  <section class="bg-navy-card px-8 py-12 border-t border-white/[0.05]">
    <div class="max-w-[1200px] mx-auto">
      <div class="font-heading text-[10px] font-bold text-[#4B5563] uppercase tracking-wider mb-5">Also worth reading</div>
      <div class="flex flex-wrap gap-2.5">
        {relatedLinks.map((l) => (
          <a href={l.href} class="inline-flex items-center gap-1.5 bg-white/[0.04] border border-white/[0.08] text-[#CBD5E1] px-3.5 py-2 rounded-md text-[13px] font-medium hover:border-brand/30 transition-colors"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6h10M7 2l4 4-4 4" stroke="#20C55E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{l.label}</a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Ready to close defects with proof?"
    body="Book a 30-minute CleanRun IQ walkthrough. See photo capture, subcontractor closeout and handover report generation on a live project."
  />

  <script is:inline>
    document.querySelectorAll('.faq-item').forEach(function (item) {
      var head = item.querySelector('.faq-head');
      var body = item.querySelector('.faq-body');
      var arrow = item.querySelector('.faq-arrow');
      head.addEventListener('click', function () {
        var open = body.style.gridTemplateRows === '1fr';
        body.style.gridTemplateRows = open ? '0fr' : '1fr';
        arrow.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
        arrow.style.color = open ? '#4B5563' : '#20C55E';
      });
    });
  </script>
</BaseLayout>
