---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { comparisons, tableDimensions, cleanRunColumn, whatCleanRunIs } from '../../data/comparisons.js';

export function getStaticPaths() {
  return comparisons.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// Chip styles for the at-a-glance table.
const labelStyles = {
  'Core': 'bg-brand/10 text-[#0C7733] border border-brand/25',
  'Available': 'bg-[#EEF2F6] text-[#374151] border border-[#DDE1E5]',
  'Limited': 'bg-[#FFF4D6] text-[#B45309] border border-[#F0D9A8]',
  'Not the focus': 'bg-[#F3F4F6] text-[#6B7280] border border-[#E2E5E9]',
  'Out of scope': 'bg-[#F3F4F6] text-[#9CA3AF] border border-[#E2E5E9]',
  'Depends on setup': 'bg-[#FFF4D6] text-[#B45309] border border-[#F0D9A8]',
};
const rows = tableDimensions.map((dim, i) => ({ dim, cleanrun: cleanRunColumn[i], competitor: c.table[i] }));
---
<BaseLayout title={c.metaTitle} description={c.metaDescription} schema={faqSchema}>
  {/* HERO */}
  <section class="bg-navy px-8 pt-[110px] pb-14 border-b border-white/[0.05]">
    <div class="max-w-[900px] mx-auto">
      <div class="mb-6"><Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare/' }, { label: `CleanRun IQ vs ${c.name}` }]} /></div>
      <h1 class="font-heading font-extrabold text-[clamp(32px,3.8vw,50px)] tracking-[-1.4px] text-white leading-[1.05] mb-5">CleanRun IQ <span class="text-[#4B5563]">vs</span> {c.name}</h1>
      <p class="text-[17px] leading-relaxed text-[#B6BEC8] max-w-[680px]">{c.heroPara}</p>
    </div>
  </section>

  {/* THREE-CARD SUMMARY */}
  <section class="bg-[#F3F4F6] px-8 py-[72px]">
    <div class="max-w-[1100px] mx-auto grid md:grid-cols-3 gap-4">
      <div class="bg-navy rounded-xl p-6 md:col-span-1">
        <div class="text-[10px] font-bold text-brand uppercase tracking-wider font-heading mb-3">The short answer</div>
        <p class="text-[14px] leading-relaxed text-[#C2C9D2]">{c.shortAnswer}</p>
      </div>
      <div class="bg-white rounded-xl border border-[#E2E5E9] p-6">
        <div class="flex items-center gap-2 mb-4"><div class="w-7 h-7 rounded-md bg-brand/10 flex items-center justify-center"><Icon name="check" size={15} class="text-[#0C7733]" width={2.4} /></div><h3 class="font-heading text-[15px] font-bold text-[#1B2025]">Pick CleanRun IQ when</h3></div>
        <ul class="flex flex-col gap-2.5">
          {c.pickCleanRun.map((p) => (
            <li class="flex items-start gap-2.5 text-[13px] leading-snug text-[#525A66]"><Icon name="check" size={13} class="text-[#0C7733] shrink-0 mt-0.5" width={2.2} />{p}</li>
          ))}
        </ul>
      </div>
      <div class="bg-white rounded-xl border border-[#E2E5E9] p-6">
        <div class="flex items-center gap-2 mb-4"><div class="w-7 h-7 rounded-md bg-[#EEF2F6] flex items-center justify-center"><Icon name="building" size={15} class="text-[#6B7280]" /></div><h3 class="font-heading text-[15px] font-bold text-[#1B2025]">Pick {c.name} when</h3></div>
        <ul class="flex flex-col gap-2.5">
          {c.pickCompetitor.map((p) => (
            <li class="flex items-start gap-2.5 text-[13px] leading-snug text-[#525A66]"><span class="w-[13px] h-[13px] rounded-full border-[1.5px] border-[#9CA3AF] shrink-0 mt-0.5"></span>{p}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* CTA STRIP */}
  <section class="bg-navy px-8 py-9 border-y border-white/[0.06]">
    <div class="max-w-[1000px] mx-auto flex items-center justify-between gap-5 flex-wrap">
      <p class="text-[16px] font-medium text-[#E5E7EB] font-heading">Run your next defect walk in CleanRun IQ.</p>
      <div class="flex items-center gap-3 flex-wrap">
        <a href="/demo/" class="inline-flex items-center gap-2 bg-brand text-navy px-5 py-3 rounded-lg text-[14px] font-bold font-heading">Try CleanRun IQ <Icon name="arrow" size={14} width={2} /></a>
        <a href="/demo/" class="inline-flex items-center gap-2 bg-white/[0.06] text-[#E5E7EB] px-5 py-3 rounded-lg text-[14px] font-medium border border-white/[0.12] hover:border-brand/40 transition-colors">Book a walkthrough</a>
      </div>
    </div>
  </section>

  {/* WHAT EACH TOOL IS */}
  <section class="bg-white px-8 py-[72px]">
    <div class="max-w-[1000px] mx-auto">
      <h2 class="font-heading font-extrabold text-[28px] md:text-[32px] tracking-[-0.8px] text-[#1B2025] mb-9">What each tool actually is.</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-[#F3F4F6] rounded-xl border border-brand/20 p-6">
          <div class="flex items-center gap-2.5 mb-3">
            <svg viewBox="0 0 100 100" width="22" height="22"><path d="M26 28 L48 50 L26 72" fill="none" stroke="#6B7280" stroke-width="13" stroke-linecap="square"></path><path d="M50 28 L72 50 L50 72" fill="none" stroke="#20C55E" stroke-width="13" stroke-linecap="square"></path></svg>
            <h3 class="font-heading text-[16px] font-extrabold text-[#1B2025]">CleanRun IQ</h3>
          </div>
          <p class="text-[14px] leading-relaxed text-[#525A66]">{whatCleanRunIs}</p>
        </div>
        <div class="bg-[#F3F4F6] rounded-xl border border-[#E2E5E9] p-6">
          <div class="flex items-center gap-2.5 mb-3"><div class="w-[22px] h-[22px] rounded-md bg-[#DDE1E5] flex items-center justify-center"><Icon name="building" size={14} class="text-[#6B7280]" /></div><h3 class="font-heading text-[16px] font-extrabold text-[#1B2025]">{c.name}</h3></div>
          <p class="text-[14px] leading-relaxed text-[#525A66]">{c.whatCompetitorIs}</p>
        </div>
      </div>
    </div>
  </section>

  {/* AT A GLANCE TABLE */}
  <section class="bg-[#F3F4F6] px-8 py-[60px] border-t border-[#E2E5E9]">
    <div class="max-w-[1000px] mx-auto">
      <h2 class="font-heading font-extrabold text-[24px] md:text-[28px] tracking-[-0.6px] text-[#1B2025] mb-6">Head to head.</h2>
      <div class="overflow-x-auto rounded-xl border border-[#E2E5E9] bg-white">
        <table class="w-full border-collapse min-w-[560px]">
          <thead>
            <tr class="bg-navy">
              <th class="text-left text-[11px] font-bold text-[#9CA3AF] uppercase tracking-wide px-5 py-3.5">Dimension</th>
              <th class="text-left text-[11px] font-bold text-brand uppercase tracking-wide px-5 py-3.5">CleanRun IQ</th>
              <th class="text-left text-[11px] font-bold text-[#9CA3AF] uppercase tracking-wide px-5 py-3.5">{c.name}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r, i) => (
              <tr class={i % 2 === 1 ? 'bg-[#F9FAFB]' : 'bg-white'}>
                <td class="text-[13px] font-semibold text-[#1B2025] px-5 py-3.5 border-t border-[#EEF1F4]">{r.dim}</td>
                <td class="px-5 py-3.5 border-t border-[#EEF1F4]">{labelStyles[r.cleanrun] ? (<span class={`inline-block text-[11px] font-bold px-2.5 py-1 rounded-md ${labelStyles[r.cleanrun]}`}>{r.cleanrun}</span>) : (<span class="text-[13px] text-[#374151]">{r.cleanrun}</span>)}</td>
                <td class="px-5 py-3.5 border-t border-[#EEF1F4]">{labelStyles[r.competitor] ? (<span class={`inline-block text-[11px] font-bold px-2.5 py-1 rounded-md ${labelStyles[r.competitor]}`}>{r.competitor}</span>) : (<span class="text-[13px] text-[#374151]">{r.competitor}</span>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[12px] text-[#9CA3AF] mt-3">Based on each product's public positioning. Always confirm current features and plans with the vendor — software changes.</p>
    </div>
  </section>

  {/* PRICING */}
  <section class="bg-white px-8 py-[72px]">
    <div class="max-w-[860px] mx-auto">
      <h2 class="font-heading font-extrabold text-[28px] md:text-[32px] tracking-[-0.8px] text-[#1B2025] mb-4">How the two are priced.</h2>
      <p class="text-[16px] leading-relaxed text-[#525A66] mb-7">{c.pricingNote}</p>
      <div class="bg-[#F3F4F6] border border-[#E2E5E9] rounded-xl p-6 flex items-center justify-between gap-5 flex-wrap">
        <div>
          <div class="font-heading text-[15px] font-bold text-[#1B2025] mb-1">CleanRun IQ pricing is simple and focused.</div>
          <p class="text-[13px] text-[#6B7280]">Start on one project, add more as it fits. Priced in AUD, no long lock-in.</p>
        </div>
        <a href="/pricing/" class="inline-flex items-center gap-2 bg-navy text-white px-5 py-3 rounded-lg text-[14px] font-bold font-heading shrink-0">See pricing <Icon name="arrow" size={14} width={2} /></a>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="bg-[#F3F4F6] px-8 py-[72px] border-t border-[#E2E5E9]">
    <div class="max-w-[760px] mx-auto">
      <h2 class="font-heading font-extrabold text-[28px] md:text-[32px] tracking-[-0.8px] text-[#1B2025] mb-8">Common questions.</h2>
      <div class="flex flex-col gap-2.5">
        {c.faqs.map((f) => (
          <div class="faq-item bg-white border border-[#E2E5E9] rounded-[10px] overflow-hidden">
            <button class="faq-head w-full flex items-start justify-between gap-3 px-5 py-4 text-left">
              <span class="font-heading text-[14.5px] font-bold text-[#1B2025] leading-snug">{f.q}</span>
              <svg class="faq-arrow shrink-0 mt-0.5 text-[#9CA3AF] transition-transform" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="faq-body grid grid-rows-[0fr] transition-all duration-300"><div class="overflow-hidden"><p class="text-[14px] leading-relaxed text-[#525A66] px-5 pb-4">{f.a}</p></div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Try CleanRun IQ on your next defect walk."
    body="Capture defects, assign trades and export a clean handover report without rebuilding your whole construction software stack."
    note="No credit card. No hard sell. Just a practical walkthrough."
  />

  <script is:inline>
    document.querySelectorAll('.faq-item').forEach(function (item) {
      var head = item.querySelector('.faq-head');
      var body = item.querySelector('.faq-body');
      var arrow = item.querySelector('.faq-arrow');
      head.addEventListener('click', function () {
        var open = body.style.gridTemplateRows === '1fr';
        body.style.gridTemplateRows = open ? '0fr' : '1fr';
        arrow.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
        arrow.style.color = open ? '#9CA3AF' : '#20C55E';
      });
    });
  </script>
</BaseLayout>
