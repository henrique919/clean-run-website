---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { comparisons } from '../../data/comparisons.js';

const dimensions = [
  'Defect capture speed',
  'Subcontractor assignment',
  'Photo evidence & close-out proof',
  'Report quality',
  'Mobile usability for site teams',
  'Pricing simplicity',
  'Setup time',
  'Focused tool vs wider enterprise suite',
];
---
<BaseLayout
  title="CleanRun IQ vs Procore, Dashpivot, Aconex & Fieldwire"
  description="Compare CleanRun IQ with Procore, Dashpivot, Aconex, Fieldwire and other construction software. See which platform fits your defect, close-out and handover workflow."
>
  {/* HERO */}
  <section class="bg-navy px-8 pt-[124px] pb-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-right opacity-[0.12] pointer-events-none" style="background-image:url('/images/site/tower-glass.webp')"></div>
    <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(90deg,#121619 38%,rgba(18,22,25,0.6) 100%)"></div>
    <div class="absolute top-0 right-0 w-1/2 h-[70%] pointer-events-none" style="background:radial-gradient(ellipse at top right,rgba(32,197,94,0.07) 0%,transparent 60%)"></div>
    <div class="max-w-[900px] mx-auto relative z-10">
      <div class="inline-flex items-center gap-2 bg-brand/[0.1] border border-brand/[0.25] rounded-full px-3.5 py-1.5 mb-6">
        <span class="text-[11px] font-bold text-brand tracking-wider uppercase font-heading">Compare</span>
      </div>
      <h1 class="font-heading font-extrabold text-[clamp(34px,4vw,52px)] tracking-[-1.4px] text-white leading-[1.06] mb-5">See how CleanRun IQ compares to the big construction software platforms.</h1>
      <p class="text-[17px] leading-relaxed text-[#B6BEC8] mb-8 max-w-[660px]">Procore, Dashpivot, Aconex, Fieldwire and VisiBuild all have their place. CleanRun IQ is different: it focuses on the defect, close-out and handover workflow most site teams still manage with spreadsheets, messages, photo folders and slow, manual report exports.</p>
      <div class="flex items-center gap-3 flex-wrap">
        <a href="/demo/" class="inline-flex items-center gap-2 bg-brand text-navy px-6 py-3.5 rounded-lg text-[15px] font-bold font-heading hover:bg-white transition-colors">Start defect tracking <Icon name="arrow" size={15} width={2} /></a>
        <a href="#comparisons" class="inline-flex items-center gap-2 bg-white/[0.06] text-[#E5E7EB] px-5.5 py-3.5 rounded-lg text-[15px] font-medium border border-white/[0.12] hover:border-brand/40 transition-colors">View comparison</a>
      </div>
    </div>
  </section>

  {/* GUARDRAIL */}
  <section class="bg-[#0C1115] px-8 py-10 border-y border-white/[0.06]">
    <div class="max-w-[900px] mx-auto flex items-start gap-4">
      <div class="w-9 h-9 rounded-lg bg-brand/[0.12] flex items-center justify-center shrink-0 mt-0.5"><Icon name="shield" size={18} class="text-brand" /></div>
      <p class="text-[16px] leading-relaxed text-[#C2C9D2]">CleanRun IQ doesn't replace your full construction management stack. It replaces the <span class="text-white font-semibold">messy defect spreadsheet, the WhatsApp chasing, the photo folders, the subcontractor lists and the painful handover report process</span> — the part most site teams still do by hand.</p>
    </div>
  </section>

  {/* INTRO — DIMENSIONS */}
  <section class="bg-white px-8 py-[80px]">
    <div class="max-w-[1000px] mx-auto">
      <div class="max-w-[620px] mb-10">
        <h2 class="font-heading font-extrabold text-[30px] md:text-[34px] tracking-[-0.8px] text-[#1B2025] mb-4 leading-[1.1]">The dimensions that actually matter for defect software.</h2>
        <p class="text-[16px] leading-relaxed text-[#525A66]">Most construction platforms can technically manage defects. The real question is how quickly your site team can capture them, assign them, prove rectification and issue a clean report without admin dragging the process down.</p>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-3">
        {dimensions.map((d) => (
          <div class="flex items-start gap-2.5 bg-[#F3F4F6] border border-[#E2E5E9] rounded-lg px-4 py-3.5">
            <Icon name="check" size={15} class="text-[#0C7733] shrink-0 mt-0.5" width={2.2} />
            <span class="text-[13px] font-medium text-[#374151] leading-snug">{d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* COMPARISON CARDS */}
  <section id="comparisons" class="bg-[#F3F4F6] px-8 py-[80px] border-t border-[#E2E5E9]">
    <div class="max-w-[1100px] mx-auto">
      <h2 class="font-heading font-extrabold text-[28px] md:text-[32px] tracking-[-0.8px] text-[#1B2025] mb-9">Pick a comparison.</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {comparisons.map((c) => (
          <a href={`/compare/${c.slug}/`} class="group bg-white rounded-xl border border-[#E2E5E9] p-6 flex flex-col hover:border-brand/40 hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-all">
            <div class="text-[10px] font-bold text-[#0C7733] uppercase tracking-wider font-heading mb-3">{c.category}</div>
            <h3 class="font-heading text-[18px] font-extrabold text-[#1B2025] mb-3">CleanRun IQ <span class="text-[#9CA3AF] font-bold">vs</span> {c.name}</h3>
            <p class="text-[13px] leading-relaxed text-[#6B7280] mb-2"><span class="font-semibold text-[#525A66]">{c.name}:</span> {c.hubSummary}</p>
            <p class="text-[13px] leading-relaxed text-[#6B7280] flex-1 mb-4"><span class="font-semibold text-[#0C7733]">CleanRun IQ:</span> {c.hubAngle}</p>
            <span class="inline-flex items-center gap-1.5 text-[12.5px] font-bold text-[#0C7733] font-heading">Read comparison <Icon name="arrow" size={12} width={2} class="group-hover:translate-x-0.5 transition-transform" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="Not sure which fits your team?"
    body="Book a short walkthrough. Tell us how your projects run and we'll be straight about whether CleanRun IQ is the right fit — or not."
    note="No credit card. No hard sell. Just a practical walkthrough."
  />
</BaseLayout>
