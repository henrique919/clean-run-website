---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Form wiring. Set these in Render → Environment (see .env.example).
const DEMO_ENDPOINT = import.meta.env.PUBLIC_DEMO_FORM_ENDPOINT || '';
const CONTACT_EMAIL = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hello@cleanruniq.com';

const seeItems = [
  { t: 'Capture on a phone, on site', d: 'Log a defect with project, building, level, unit, room, trade and type in under a minute.' },
  { t: 'Trade response and rectification photo', d: 'How a subcontractor picks up an item, uploads a rectification photo and sends it back for review.' },
  { t: 'The defect register everyone works from', d: 'Open, issued, review and closed items across the project, filtered by trade or location.' },
  { t: 'The handover pack', d: 'Produce a defect report with original photo, rectification photo and closeout record attached.' },
];
const inputCls = 'w-full bg-white/[0.06] border border-white/[0.14] rounded-md px-3 py-2.5 text-sm text-white placeholder:text-[#6B7280] focus:outline-none focus:border-brand/60';
const selectCls = inputCls + ' appearance-none';
const labelCls = 'text-[11px] font-bold text-[#9CA3AF] uppercase tracking-wide block mb-1.5';
---
<BaseLayout
  title="Book a 20-minute walkthrough"
  description="Book a 20-minute CleanRun IQ walkthrough. See defect capture, trade response, review and the handover pack using a realistic construction closeout workflow."
>
  {/* HERO + FORM */}
  <section class="min-h-screen bg-navy pt-[66px] relative overflow-hidden flex items-center">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.12] pointer-events-none" style="background-image:url('/images/people/person-inspector.webp')"></div>
    <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(180deg,#121619 35%,rgba(18,22,25,0.7) 100%)"></div>
    <div class="absolute right-0 top-[15%] w-[45%] h-[55%] pointer-events-none" style="background:radial-gradient(ellipse at right,rgba(32,197,94,0.05) 0%,transparent 65%)"></div>
    <div class="max-w-[1200px] w-full mx-auto px-8 py-20 grid lg:grid-cols-2 gap-18 items-start relative z-10">

      {/* Left copy */}
      <div class="pt-6">
        <div class="inline-flex items-center gap-2 bg-brand/[0.1] border border-brand/[0.25] rounded-full px-3.5 py-1.5 mb-6">
          <Icon name="clock" size={13} class="text-brand" />
          <span class="text-[11px] font-bold text-brand tracking-wider uppercase font-heading">20-minute walkthrough</span>
        </div>
        <h1 class="font-heading font-extrabold leading-[1.06] tracking-[-1.5px] text-white mb-4.5 text-[clamp(32px,3.6vw,52px)]">See how it would work on a real project.</h1>
        <p class="text-[17px] leading-relaxed text-[#B6BEC8] mb-9 max-w-[440px]">Book a short walkthrough and we'll show you capture, trade response, review and the handover pack using realistic construction closeout data — not a polished sales deck.</p>

        <div class="mb-9">
          <div class="font-heading text-[11px] font-bold text-[#9CA3AF] uppercase tracking-wider mb-4">What we'll go through</div>
          <div class="flex flex-col gap-3">
            {seeItems.map((item) => (
              <div class="flex items-start gap-3">
                <div class="w-5.5 h-5.5 bg-brand/[0.12] rounded-md flex items-center justify-center shrink-0 mt-0.5"><Icon name="check" size={12} class="text-brand" width={2.2} /></div>
                <div><div class="text-[13px] font-semibold text-[#E5E7EB] mb-0.5">{item.t}</div><div class="text-xs text-[#8A93A0] leading-snug">{item.d}</div></div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white/[0.04] border border-white/[0.08] rounded-[10px] px-4.5 py-4 flex flex-col gap-2.5">
          {['No credit card. No hard sell.','We use realistic construction closeout data, not a rehearsed deck.','Ask the questions you’d ask in a site or handover meeting.'].map((t) => (
            <div class="flex items-center gap-2.5 text-xs text-[#A8B0BB]"><Icon name="check" size={13} class="text-brand shrink-0" width={2} />{t}</div>
          ))}
        </div>
      </div>

      {/* Right: form / success */}
      <div>
        <div id="demo-form-card" class="bg-navy-card border border-white/[0.1] rounded-[14px] p-9 px-8">
          <h2 class="font-heading text-[22px] font-extrabold text-white mb-1.5 tracking-[-0.3px]">Book your walkthrough</h2>
          <p class="text-[13px] text-[#8A93A0] mb-6.5">Takes about a minute. We'll reply to set a time that suits the site.</p>
          <form id="demo-form" novalidate class="flex flex-col gap-3">
            <div class="grid grid-cols-2 gap-3">
              <div><label class={labelCls} for="f-first">First name *</label><input id="f-first" type="text" name="first_name" required placeholder="James" class={inputCls} /></div>
              <div><label class={labelCls} for="f-last">Last name *</label><input id="f-last" type="text" name="last_name" required placeholder="Smith" class={inputCls} /></div>
            </div>
            <div><label class={labelCls} for="f-email">Work email *</label><input id="f-email" type="email" name="email" required placeholder="james@buildco.com.au" class={inputCls} /></div>
            <div><label class={labelCls} for="f-company">Company *</label><input id="f-company" type="text" name="company" required placeholder="Buildco Pty Ltd" class={inputCls} /></div>
            <div class="grid grid-cols-2 gap-3">
              <div><label class={labelCls} for="f-role">Your role *</label>
                <select id="f-role" name="role" required class={selectCls}>
                  <option value="">Select role…</option>
                  <option>Project Manager</option><option>Site Manager</option><option>Quality Manager</option><option>Builder / Director</option><option>Contractor</option><option>Subcontractor</option><option>Other</option>
                </select>
              </div>
              <div><label class={labelCls} for="f-projects">Active projects *</label>
                <select id="f-projects" name="active_projects" required class={selectCls}>
                  <option value="">Select…</option><option>1–5 projects</option><option>6–20 projects</option><option>21+ projects</option>
                </select>
              </div>
            </div>
            <div><label class={labelCls} for="f-tool">Current defect tracking method *</label>
              <select id="f-tool" name="current_tool" required class={selectCls}>
                <option value="">Select…</option><option>Excel / spreadsheet</option><option>Messages / WhatsApp</option><option>Paper / defect walk notes</option><option>Another software tool</option><option>Nothing formal yet</option>
              </select>
            </div>
            <div><label class={labelCls} for="f-challenge">Main challenge *</label><textarea id="f-challenge" name="challenge" required rows="2" placeholder="e.g. chasing rectification photos before PC, or proving what was closed at DLP" class={inputCls + ' resize-y leading-snug'}></textarea></div>
            <div id="demo-error" class="hidden text-[12.5px] leading-snug text-[#FCA5A5] bg-[#B42318]/[0.1] border border-[#B42318]/25 rounded-md px-3 py-2.5"></div>
            <button type="submit" id="demo-submit" class="w-full bg-brand text-navy rounded-lg py-3.5 text-[15px] font-extrabold font-heading tracking-[-0.2px] mt-0.5 disabled:opacity-60">Book my walkthrough</button>
          </form>
          <p class="text-[11px] text-[#7A828E] text-center mt-3.5">No spam, no hard sell — just a practical walkthrough.</p>
        </div>

        {/* Success */}
        <div id="demo-success" class="hidden bg-navy-card border border-brand/[0.25] rounded-[14px] p-12 px-10 text-center">
          <div class="w-14 h-14 bg-brand/[0.12] rounded-full flex items-center justify-center mx-auto mb-5"><Icon name="check" size={26} class="text-brand" width={2.5} /></div>
          <h2 class="font-heading text-[28px] font-extrabold text-white mb-2.5 tracking-[-0.5px]">Request received.</h2>
          <p class="text-[15px] text-[#B6BEC8] mb-5.5 leading-relaxed">Thanks — we've got your details and we'll be in touch to set a walkthrough time that suits your site.</p>
          <div class="bg-brand/[0.06] border border-brand/[0.18] rounded-lg px-4.5 py-3.5 text-left mb-5.5">
            <div class="font-heading text-[11px] font-bold text-brand uppercase tracking-wider mb-1.5">While you wait</div>
            <p class="text-[13px] text-[#A8B0BB] leading-snug">Grab the free <a href="/resources/defect-closeout-checklist/" class="text-brand font-semibold underline-offset-2 hover:underline">defect closeout checklist</a> — the field steps we'll walk through.</p>
          </div>
          <a href="/" class="inline-flex items-center gap-1.5 text-[13px] text-[#8A93A0] hover:text-white transition-colors">Back to home</a>
        </div>
      </div>
    </div>
  </section>

  {/* SAMPLE REGISTER ALT */}
  <section class="bg-navy-card border-t border-white/[0.06] px-8 py-10">
    <div class="max-w-[760px] mx-auto text-center">
      <div class="text-[13px] text-[#8A93A0] mb-2.5">Not ready to book?</div>
      <h3 class="font-heading text-xl font-bold text-white mb-2">Have a look at a sample defect register first.</h3>
      <p class="text-sm text-[#A8B0BB] mb-5 leading-snug">See how items, photos, trades and closeout status sit together before you talk to us.</p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <a href="/features/defect-management/" class="inline-flex items-center gap-1.5 bg-white/[0.06] border border-white/[0.12] text-[#E5E7EB] px-5 py-2.5 rounded-lg text-sm font-medium hover:border-brand/40 transition-colors">See sample defect register</a>
        <a href="/resources/defect-closeout-checklist/" class="inline-flex items-center gap-1.5 text-sm text-brand font-semibold"><Icon name="checklist" size={14} />Download the defect closeout checklist</a>
      </div>
    </div>
  </section>

  <script define:vars={{ DEMO_ENDPOINT, CONTACT_EMAIL }}>
    (function () {
      var form = document.getElementById('demo-form');
      if (!form) return;
      var errBox = document.getElementById('demo-error');
      var submitBtn = document.getElementById('demo-submit');

      function showError(msg) { errBox.textContent = msg; errBox.classList.remove('hidden'); }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errBox.classList.add('hidden');

        if (!form.checkValidity()) { form.reportValidity(); return; }

        // No endpoint configured yet — be honest, don't fake a success.
        if (!DEMO_ENDPOINT) {
          showError('Our booking form isn’t connected to our inbox yet. Please email ' + CONTACT_EMAIL + ' and we’ll set up your walkthrough.');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
        var data = Object.fromEntries(new FormData(form).entries());

        fetch(DEMO_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        })
          .then(function (res) {
            if (!res.ok) throw new Error('bad status');
            if (window.gtag) window.gtag('event', 'generate_lead', { event_category: 'demo', event_label: 'demo_walkthrough' });
            if (window.clarity) window.clarity('event', 'demo_booked');
            document.getElementById('demo-form-card').classList.add('hidden');
            var s = document.getElementById('demo-success');
            s.classList.remove('hidden');
            s.scrollIntoView({ behavior: 'smooth', block: 'center' });
          })
          .catch(function () {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Book my walkthrough';
            showError('Something went wrong sending your request. Please email ' + CONTACT_EMAIL + ' and we’ll sort your walkthrough.');
          });
      });
    })();
  </script>
</BaseLayout>
