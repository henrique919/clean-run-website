---
import BaseLayout from '../layouts/BaseLayout.astro';

const seeItems = [
  { t: 'On-site photo capture', d: 'Capture a defect on mobile in under 30 seconds, with all required fields enforced.' },
  { t: 'Trade assignment and subcontractor response', d: 'How a subcontractor receives, responds to and closes a defect from their phone.' },
  { t: 'Live defect register and status board', d: 'Every open, issued and closed item across the project at a glance.' },
  { t: 'Handover report generation', d: 'Generate a full handover report with all evidence in seconds \u2014 not days.' },
];
const inputCls = 'w-full bg-white/[0.05] border border-white/10 rounded-md px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand/50';
const selectCls = inputCls + ' appearance-none';
const labelCls = 'text-[11px] font-bold text-[#4B5563] uppercase tracking-wide block mb-1.5';
---
<BaseLayout
  title="Book a Demo"
  description="Book a 30-minute CleanRun IQ walkthrough. See live defect capture, subcontractor closeout and handover report generation on a real construction project."
>
  {/* HERO + FORM */}
  <section class="min-h-screen bg-navy pt-[66px] relative overflow-hidden flex items-center">
    <div class="absolute inset-0 grid-overlay pointer-events-none"></div>
    <div class="absolute right-0 top-[15%] w-[45%] h-[60%] pointer-events-none" style="background:radial-gradient(ellipse at right,rgba(32,197,94,0.06) 0%,transparent 65%)"></div>
    <div class="max-w-[1200px] w-full mx-auto px-8 py-20 grid lg:grid-cols-2 gap-18 items-start relative z-10">

      {/* Left copy */}
      <div class="pt-6">
        <div class="inline-flex items-center gap-2 bg-brand/[0.08] border border-brand/[0.22] rounded-full px-3.5 py-1.5 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-blink"></span>
          <span class="text-[11px] font-bold text-brand tracking-wider uppercase font-heading">30-minute walkthrough</span>
        </div>
        <h1 class="font-heading font-extrabold leading-[1.06] tracking-[-1.5px] text-white mb-4.5 text-[clamp(36px,3.6vw,54px)]">See what clean handovers look like.</h1>
        <p class="text-[17px] leading-relaxed text-[#9CA3AF] mb-9 max-w-[440px]">Book a walkthrough with the CleanRun IQ team. We'll use a live project \u2014 not a polished sales deck \u2014 to show you exactly how defect closeout works.</p>

        <div class="mb-9">
          <div class="font-heading text-[10px] font-bold text-[#4B5563] uppercase tracking-wider mb-4">In 30 minutes you'll see</div>
          <div class="flex flex-col gap-3">
            {seeItems.map((item) => (
              <div class="flex items-start gap-3">
                <div class="w-5.5 h-5.5 bg-brand/10 rounded-md flex items-center justify-center shrink-0 mt-0.5"><svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M1 5l2.5 2.5 6.5-6.5" stroke="#20C55E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <div><div class="text-[13px] font-semibold text-[#E5E7EB] mb-0.5">{item.t}</div><div class="text-xs text-[#4B5563] leading-snug">{item.d}</div></div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white/[0.03] border border-white/[0.06] rounded-[10px] px-4.5 py-4 flex flex-col gap-2">
          {['No credit card. No obligation.','Live project data \u2014 not a rehearsed deck.','Ask any questions you\u2019d ask in a site meeting.'].map((t) => (
            <div class="flex items-center gap-2.5 text-xs text-[#6B7280]"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6l2.5 2.5 7-7" stroke="#20C55E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{t}</div>
          ))}
        </div>
      </div>

      {/* Right: form / success */}
      <div>
        <div id="demo-form-card" class="bg-navy-card border border-white/[0.08] rounded-[14px] p-9 px-8">
          <h2 class="font-heading text-[22px] font-extrabold text-white mb-1.5 tracking-[-0.3px]">Book your demo</h2>
          <p class="text-[13px] text-[#4B5563] mb-6.5">Takes 60 seconds. We'll confirm within 2 hours.</p>
          {/* TODO: set action to your CRM/Formspree/HubSpot endpoint. JS below intercepts and shows success. */}
          <form id="demo-form" action="#" method="POST" class="flex flex-col gap-3">
            <div class="grid grid-cols-2 gap-3">
              <div><label class={labelCls}>First name *</label><input type="text" name="first_name" required placeholder="James" class={inputCls} /></div>
              <div><label class={labelCls}>Last name *</label><input type="text" name="last_name" required placeholder="Smith" class={inputCls} /></div>
            </div>
            <div><label class={labelCls}>Work email *</label><input type="email" name="email" required placeholder="james@buildco.com.au" class={inputCls} /></div>
            <div><label class={labelCls}>Company *</label><input type="text" name="company" required placeholder="Buildco Pty Ltd" class={inputCls} /></div>
            <div class="grid grid-cols-2 gap-3">
              <div><label class={labelCls}>Your role *</label>
                <select name="role" required class={selectCls}>
                  <option value="">Select role…</option>
                  <option>Project Manager</option><option>Site Manager</option><option>Quality Manager</option><option>Builder / Director</option><option>Contractor</option><option>Other</option>
                </select>
              </div>
              <div><label class={labelCls}>Active projects</label>
                <select name="projects" class={selectCls}>
                  <option value="">Select…</option><option>1–5 projects</option><option>6–20 projects</option><option>21+ projects</option>
                </select>
              </div>
            </div>
            <div><label class={labelCls}>Current defect tracking method</label>
              <select name="current_tool" class={selectCls}>
                <option value="">Select…</option><option>Excel / spreadsheet</option><option>WhatsApp / text messages</option><option>Paper / site walk notes</option><option>Another software tool</option><option>Nothing formal yet</option>
              </select>
            </div>
            <div><label class={labelCls}>Main challenge (optional)</label><textarea name="challenge" rows="2" placeholder="e.g. trades not uploading evidence, handover reports taking too long…" class={inputCls + ' resize-y leading-snug'}></textarea></div>
            <button type="submit" class="w-full bg-brand text-navy rounded-lg py-3.5 text-[15px] font-extrabold font-heading tracking-[-0.2px] mt-0.5">Book my demo →</button>
          </form>
          <p class="text-[11px] text-[#374151] text-center mt-3.5">No spam. No sales pressure. Just a 30-minute walkthrough.</p>
        </div>

        {/* Success */}
        <div id="demo-success" class="hidden bg-navy-card border border-brand/[0.22] rounded-[14px] p-12 px-10 text-center">
          <div class="w-14 h-14 bg-brand/10 rounded-full flex items-center justify-center mx-auto mb-5"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#20C55E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <h2 class="font-heading text-[28px] font-extrabold text-white mb-2.5 tracking-[-0.5px]">You're booked.</h2>
          <p class="text-[15px] text-[#9CA3AF] mb-5.5 leading-relaxed">We'll be in touch within 2 hours with your confirmed demo time and a calendar invite.</p>
          <div class="bg-brand/[0.05] border border-brand/[0.15] rounded-lg px-4.5 py-3.5 text-left mb-5.5">
            <div class="font-heading text-[11px] font-bold text-brand uppercase tracking-wider mb-1.5">While you wait</div>
            <p class="text-[13px] text-[#6B7280] leading-snug">Download the free <a href="/resources/defect-closeout-checklist/" class="text-brand font-semibold">Defect Closeout Checklist</a> \u2014 the field guide we'll reference in the demo.</p>
          </div>
          <a href="/" class="inline-flex items-center gap-1.5 text-[13px] text-[#4B5563]">← Back to home</a>
        </div>
      </div>
    </div>
  </section>

  {/* LIVE DEMO ALT */}
  <section class="bg-navy-card border-t border-white/[0.05] px-8 py-10">
    <div class="max-w-[760px] mx-auto text-center">
      <div class="text-[13px] text-[#4B5563] mb-2.5">Not ready for a guided demo?</div>
      <h3 class="font-heading text-xl font-bold text-white mb-2">Explore CleanRun IQ yourself first.</h3>
      <p class="text-sm text-[#6B7280] mb-5 leading-snug">The live app is at app.cleanruniq.com. Log in with your own account or ask us for sandbox access with sample project data.</p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <a href="https://app.cleanruniq.com/" class="inline-flex items-center gap-1.5 bg-white/[0.05] border border-white/10 text-[#E5E7EB] px-5 py-2.5 rounded-lg text-sm font-medium">View Live App</a>
        <a href="/resources/defect-closeout-checklist/" class="inline-flex items-center gap-1.5 text-sm text-brand font-semibold"><svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2 4.5h9M2 7.5h9M2 10.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>Download Defect Checklist</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('demo-form');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        // TODO: replace with real submission (fetch to CRM/Formspree/HubSpot).
        document.getElementById('demo-form-card').classList.add('hidden');
        var success = document.getElementById('demo-success');
        success.classList.remove('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    })();
  </script>
</BaseLayout>
