---
import SEOHead from '../components/SEOHead.astro';
import Schema from '../components/Schema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// Root layout: <head> SEO, global Organization + WebSite schema, header, footer.
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

const { title, description, canonical, ogImage, ogType, noindex, schema } = Astro.props;

// Present on every page
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CleanRun IQ',
  url: 'https://www.cleanruniq.com',
  logo: 'https://www.cleanruniq.com/logo.svg',
  description:
    'CleanRun IQ is construction defect management and handover reporting software for Australian builders and site teams.',
  sameAs: ['https://tanqo.co'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CleanRun IQ',
  url: 'https://www.cleanruniq.com',
  description:
    'Construction defect management and handover reporting software for Australian builders and site teams.',
};
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  {/* Fonts — Archivo (headings) + Inter (body) */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <SEOHead title={title} description={description} canonical={canonical} ogImage={ogImage} ogType={ogType} noindex={noindex} />
  <Schema schema={orgSchema} />
  <Schema schema={websiteSchema} />
  {schema && <Schema schema={schema} />}
</head>
<body class="bg-navy text-white font-sans antialiased overflow-x-hidden">
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
