---
// Image markup mockup — mirrors the real CleanRun IQ "Mark up evidence" tool:
// header, photo with hand-drawn red annotation, and the Tool / Colour / Width
// control row with Undo, Reset and "Save marked-up copy". Static, no JS.
export interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<div class={`bg-[#1B2025] border border-white/[0.1] rounded-2xl overflow-hidden shadow-[0_24px_60px_rgba(0,0,0,0.45)] ${cls}`}>
  {/* Header */}
  <div class="flex items-center justify-between px-4 py-3 border-b border-white/[0.07]">
    <span class="text-[13px] font-bold text-white font-heading">Mark up evidence</span>
    <span class="text-[11px] text-[#A8B0BB] border border-white/15 rounded-md px-2.5 py-1">Close</span>
  </div>

  {/* Photo with hand-drawn red annotation */}
  <div class="relative bg-[#0C1115]">
    <img src="/images/defects/cracked-wall.webp" alt="Defect photo with a hand-drawn red markup circle" loading="lazy" decoding="async" class="w-full h-[240px] object-cover block opacity-95" />
    <svg viewBox="0 0 400 240" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true">
      <path d="M150 70 C 95 78, 92 150, 150 168 C 215 188, 305 170, 300 115 C 296 72, 205 58, 150 70 Z" fill="none" stroke="#D92D20" stroke-width="5" stroke-linecap="round"></path>
      <path d="M150 120 l 60 4" fill="none" stroke="#D92D20" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 18"></path>
      <path d="M120 135 l 22 -2" fill="none" stroke="#D92D20" stroke-width="5" stroke-linecap="round"></path>
    </svg>
  </div>

  {/* Controls */}
  <div class="px-4 py-3.5">
    <div class="flex items-end gap-3 mb-3">
      <div>
        <div class="text-[9px] font-bold text-[#6B7280] uppercase tracking-wide mb-1">Tool</div>
        <div class="flex items-center justify-between gap-3 bg-white/[0.05] border border-white/[0.12] rounded-md px-2.5 py-1.5 w-[96px]">
          <span class="text-[12px] text-white font-medium">Pen</span>
          <svg width="10" height="10" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
      <div>
        <div class="text-[9px] font-bold text-[#6B7280] uppercase tracking-wide mb-1">Colour</div>
        <div class="w-9 h-8 rounded-md bg-[#D92D20] ring-2 ring-white"></div>
      </div>
      <div class="flex-1">
        <div class="text-[9px] font-bold text-[#6B7280] uppercase tracking-wide mb-1">Width</div>
        <div class="h-8 flex items-center"><div class="relative w-full h-1 rounded-full bg-white/15"><span class="absolute left-[58%] -top-[5px] w-3.5 h-3.5 rounded-full bg-white shadow"></span></div></div>
      </div>
      <span class="text-[11px] text-white border border-white/15 rounded-md px-3 py-1.5 self-end">Undo</span>
    </div>
    <div class="flex items-center gap-2.5">
      <span class="text-[12px] text-white border border-white/15 rounded-md px-3.5 py-2">Reset</span>
      <span class="flex-1 text-center text-[12.5px] font-bold text-navy bg-brand rounded-md py-2 font-heading">Save marked-up copy</span>
    </div>
  </div>
</div>
