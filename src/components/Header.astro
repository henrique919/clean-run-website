---
// Fixed site header. Transparent over hero, glass on scroll. Includes mobile menu.
const navLinks = [
  { href: '/features/', label: 'Features' },
  { href: '/solutions/', label: 'Solutions' },
  { href: '/resources/', label: 'Resources' },
  { href: '/compare/', label: 'Compare' },
  { href: '/pricing/', label: 'Pricing' },
];
---
<nav id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300 border-b border-transparent">
  <div class="max-w-[1200px] mx-auto px-6 sm:px-8 flex items-center justify-between h-[66px]">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="CleanRun IQ home">
      <svg viewBox="0 0 100 100" width="28" height="28" aria-hidden="true">
        <path d="M26 28 L48 50 L26 72" fill="none" stroke="#6B7280" stroke-width="13" stroke-linecap="square" stroke-linejoin="miter"></path>
        <path d="M50 28 L72 50 L50 72" fill="none" stroke="#20C55E" stroke-width="13" stroke-linecap="square" stroke-linejoin="miter"></path>
      </svg>
      <span class="font-heading font-extrabold text-[17px] text-white tracking-tight">CleanRun <span class="text-brand">IQ</span></span>
    </a>

    <div class="hidden md:flex items-center gap-7">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-[#A8B0BB] hover:text-white transition-colors">{link.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-3 shrink-0">
      <a href="https://app.cleanruniq.com/" class="hidden sm:inline text-sm font-medium text-[#A8B0BB] hover:text-white transition-colors">Log in</a>
      <a href="/demo/" class="bg-brand text-navy px-4 sm:px-5 py-2.5 rounded-lg text-[13px] sm:text-sm font-bold font-heading whitespace-nowrap hover:bg-brand-dark hover:text-white transition-colors hidden sm:inline">Book a 20-minute walkthrough</a>
      <a href="/demo/" class="bg-brand text-navy px-4 py-2.5 rounded-lg text-[13px] font-bold font-heading whitespace-nowrap sm:hidden">Book demo</a>
      <button id="nav-toggle" type="button" class="md:hidden w-9 h-9 flex items-center justify-center rounded-md text-[#A8B0BB] hover:text-white hover:bg-white/[0.06] transition-colors" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg id="nav-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg id="nav-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  {/* Mobile menu */}
  <div id="mobile-menu" class="md:hidden hidden bg-[#0C1115] border-t border-white/[0.08]">
    <div class="px-6 py-4 flex flex-col">
      {navLinks.map((link) => (
        <a href={link.href} class="text-[15px] font-medium text-[#C2C9D2] hover:text-brand py-3 border-b border-white/[0.05] transition-colors">{link.label}</a>
      ))}
      <a href="https://app.cleanruniq.com/" class="text-[15px] font-medium text-[#C2C9D2] hover:text-brand py-3 transition-colors">Log in</a>
      <a href="/demo/" class="mt-3 bg-brand text-navy text-center px-5 py-3 rounded-lg text-[15px] font-bold font-heading">Book a 20-minute walkthrough</a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var nav = document.getElementById('site-nav');
    var toggle = document.getElementById('nav-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('nav-icon-open');
    var iconClose = document.getElementById('nav-icon-close');

    function setNavBg() {
      var scrolled = window.scrollY > 60;
      var open = menu && !menu.classList.contains('hidden');
      if (scrolled || open) {
        nav.style.background = 'rgba(12,17,21,0.97)';
        nav.style.backdropFilter = 'blur(16px)';
        nav.style.webkitBackdropFilter = 'blur(16px)';
        nav.style.borderBottomColor = 'rgba(255,255,255,0.06)';
      } else {
        nav.style.background = 'transparent';
        nav.style.backdropFilter = 'none';
        nav.style.webkitBackdropFilter = 'none';
        nav.style.borderBottomColor = 'transparent';
      }
    }
    function closeMenu() {
      menu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      setNavBg();
    }
    function openMenu() {
      menu.classList.remove('hidden');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      setNavBg();
    }
    toggle.addEventListener('click', function () {
      menu.classList.contains('hidden') ? openMenu() : closeMenu();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu();
    });
    window.addEventListener('scroll', setNavBg, { passive: true });
    setNavBg();
  })();
</script>
