---
// Site footer with link columns.
const featureLinks = [
  { href: '/features/defect-management/', label: 'Defect Management' },
  { href: '/features/punch-list-software/', label: 'Punch List Software' },
  { href: '/features/photo-evidence/', label: 'Photo Evidence' },
  { href: '/features/subcontractor-closeout/', label: 'Subcontractor Closeout' },
  { href: '/features/handover-reports/', label: 'Handover Reports' },
];
const solutionLinks = [
  { href: '/solutions/project-managers/', label: 'Project Managers' },
  { href: '/solutions/site-managers/', label: 'Site Managers' },
  { href: '/solutions/quality-managers/', label: 'Quality Managers' },
  { href: '/solutions/builders/', label: 'Builders' },
  { href: '/solutions/subcontractors/', label: 'Subcontractors' },
];
const companyLinks = [
  { href: '/pricing/', label: 'Pricing' },
  { href: '/demo/', label: 'Book a Demo' },
  { href: '/resources/', label: 'Resources' },
  { href: '/compare/', label: 'Compare' },
  { href: '/security/', label: 'Security' },
  { href: 'https://app.cleanruniq.com/', label: 'Log in to App' },
];
const year = new Date().getFullYear();
---
<footer class="bg-navy-dark border-t border-white/[0.05] px-8 pt-12 pb-8">
  <div class="max-w-[1200px] mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-11">
      <div>
        <div class="flex items-center gap-2.5 mb-3.5">
          <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true">
            <path d="M26 28 L48 50 L26 72" fill="none" stroke="#6B7280" stroke-width="13" stroke-linecap="square" stroke-linejoin="miter"></path>
            <path d="M50 28 L72 50 L50 72" fill="none" stroke="#20C55E" stroke-width="13" stroke-linecap="square" stroke-linejoin="miter"></path>
          </svg>
          <span class="font-heading font-extrabold text-sm text-white">CleanRun <span class="text-brand">IQ</span></span>
        </div>
        <p class="text-xs text-ink-muted leading-relaxed mb-3.5 max-w-[200px]">Capture, assign and close construction defects from one live register. Built for Australian site teams.</p>
        <a href="/demo/" class="inline-block bg-brand text-navy px-4 py-1.5 rounded-md text-xs font-bold font-heading">Book a Demo</a>
      </div>

      <div>
        <div class="font-heading text-[11px] font-bold text-ink-muted uppercase tracking-wider mb-3.5">Features</div>
        <div class="flex flex-col gap-2.5">
          {featureLinks.map((l) => <a href={l.href} class="text-[13px] text-ink-muted hover:text-brand transition-colors">{l.label}</a>)}
        </div>
      </div>

      <div>
        <div class="font-heading text-[11px] font-bold text-ink-muted uppercase tracking-wider mb-3.5">Solutions</div>
        <div class="flex flex-col gap-2.5">
          {solutionLinks.map((l) => <a href={l.href} class="text-[13px] text-ink-muted hover:text-brand transition-colors">{l.label}</a>)}
        </div>
      </div>

      <div>
        <div class="font-heading text-[11px] font-bold text-ink-muted uppercase tracking-wider mb-3.5">Company</div>
        <div class="flex flex-col gap-2.5">
          {companyLinks.map((l) => <a href={l.href} class="text-[13px] text-ink-muted hover:text-brand transition-colors">{l.label}</a>)}
        </div>
      </div>
    </div>

    <div class="border-t border-white/[0.05] pt-5 flex items-center justify-between flex-wrap gap-3">
      <span class="text-xs text-ink-muted/70">&copy; {year} CleanRun IQ. All rights reserved.</span>
      <div class="flex gap-5">
        <a href="/privacy/" class="text-xs text-ink-muted/70 hover:text-brand transition-colors">Privacy Policy</a>
        <a href="/security/" class="text-xs text-ink-muted/70 hover:text-brand transition-colors">Security</a>
        <a href="/contact/" class="text-xs text-ink-muted/70 hover:text-brand transition-colors">Contact</a>
        <a href="/sep.html" class="text-xs text-ink-muted/70 hover:text-brand transition-colors">Construction Resources</a>
        <a href="/henry-sestak.html" class="text-xs text-ink-muted/70 hover:text-brand transition-colors">Henry Sestak</a>
      </div>
    </div>
  </div>
</footer>
