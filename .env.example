# Copy to .env.local for local dev. In Render, set these under
# Dashboard -> cleanruniq-website -> Environment (render.yaml declares the
# keys with sync: false, so Render will prompt for values there).

# Where the "Book a walkthrough" and resource-download forms POST to
# (JSON body, expects a 2xx response). Any form backend works — e.g. a
# Formspree/Basin endpoint, or a small serverless function. Until this is
# set, the forms fall back to a pre-filled mailto: link instead of failing
# silently — see src/pages/demo.astro.
PUBLIC_DEMO_FORM_ENDPOINT=

# Shown in the mailto: fallback and in "email us" copy across the site.
PUBLIC_CONTACT_EMAIL=hello@cleanruniq.com
